{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.stegoceratops.main": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "hurt": "query.is_hurt"
            },
            {
              "graze": "query.action == 'graze'"
            },
            {
              "attack": "query.action == 'attack' || query.action == 'roar'"
            },
            {
              "charge": "query.is_moving && query.is_running && query.is_attacking"
            },
            {
              "walk": "query.is_moving"
            }
          ],
          "blend_transition": 0.2
        },
        "walk": {
          "animations": [
            "idle",
            "walk"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "hurt": "query.is_hurt"
            },
            {
              "charge": "query.is_running && query.is_attacking"
            },
            {
              "idle": "!query.is_moving"
            }
          ],
          "blend_transition": 0.15
        },
        "charge": {
          "animations": [
            "charge"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "walk": "!query.is_attacking && query.is_moving"
            },
            {
              "idle": "!query.is_moving"
            }
          ],
          "blend_transition": 0.1
        },
        "attack": {
          "animations": [
            "bellow"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "charge": "query.action == 'none' && query.is_running"
            },
            {
              "walk": "query.action == 'none' && query.is_moving"
            },
            {
              "idle": "query.action == 'none'"
            }
          ],
          "blend_transition": 0.1
        },
        "graze": {
          "animations": [
            "graze"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "hurt": "query.is_hurt"
            },
            {
              "walk": "query.is_moving"
            },
            {
              "idle": "query.action != 'graze'"
            }
          ],
          "blend_transition": 0.3
        },
        "hurt": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "charge": "!query.is_hurt && query.is_running && query.is_attacking"
            },
            {
              "walk": "!query.is_hurt && query.is_moving"
            },
            {
              "idle": "!query.is_hurt"
            }
          ],
          "blend_transition": 0.05
        },
        "death": {
          "animations": [
            "idle"
          ],
          "blend_transition": 0.2
        }
      }
    }
  }
}

{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.quetzalcoatlus.main": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "hurt": "query.is_hurt"
            },
            {
              "roar": "query.action == 'roar'"
            },
            {
              "attack": "query.action == 'attack'"
            },
            {
              "special": "query.action == 'graze' || query.action == 'eat'"
            },
            {
              "fly": "!query.is_on_ground"
            },
            {
              "sit": "query.is_sitting"
            },
            {
              "walk": "query.is_moving"
            }
          ],
          "blend_transition": 0.2
        },
        "walk": {
          "animations": [
            "walk"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "hurt": "query.is_hurt"
            },
            {
              "roar": "query.action == 'roar'"
            },
            {
              "attack": "query.action == 'attack'"
            },
            {
              "fly": "!query.is_on_ground"
            },
            {
              "idle": "!query.is_moving"
            }
          ],
          "blend_transition": 0.15
        },
        "fly": {
          "animations": [
            "fly"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "hurt": "query.is_hurt"
            },
            {
              "roar": "query.action == 'roar'"
            },
            {
              "attack": "query.action == 'attack'"
            },
            {
              "idle": "query.is_on_ground && !query.is_moving"
            },
            {
              "walk": "query.is_on_ground"
            },
            {
              "glide": "query.is_running"
            }
          ],
          "blend_transition": 0.25
        },
        "glide": {
          "animations": [
            "glide"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "hurt": "query.is_hurt"
            },
            {
              "roar": "query.action == 'roar'"
            },
            {
              "attack": "query.action == 'attack'"
            },
            {
              "idle": "query.is_on_ground && !query.is_moving"
            },
            {
              "walk": "query.is_on_ground"
            },
            {
              "fly": "!query.is_running"
            }
          ],
          "blend_transition": 0.4
        },
        "attack": {
          "animations": [
            "attack"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "fly": "query.action == 'none' && !query.is_on_ground"
            },
            {
              "walk": "query.action == 'none' && query.is_moving"
            },
            {
              "idle": "query.action == 'none'"
            }
          ],
          "blend_transition": 0.05
        },
        "roar": {
          "animations": [
            "roar"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "fly": "query.action == 'none' && !query.is_on_ground"
            },
            {
              "walk": "query.action == 'none' && query.is_moving"
            },
            {
              "idle": "query.action == 'none'"
            }
          ],
          "blend_transition": 0.1
        },
        "special": {
          "animations": [
            "special"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "fly": "query.action == 'none' && !query.is_on_ground"
            },
            {
              "walk": "query.action == 'none' && query.is_moving"
            },
            {
              "idle": "query.action == 'none'"
            }
          ],
          "blend_transition": 0.15
        },
        "hurt": {
          "animations": [
            "hurt"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "fly": "!query.is_hurt && !query.is_on_ground"
            },
            {
              "walk": "!query.is_hurt && query.is_moving"
            },
            {
              "idle": "!query.is_hurt"
            }
          ],
          "blend_transition": 0.05
        },
        "sit": {
          "animations": [
            "sit"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "hurt": "query.is_hurt"
            },
            {
              "fly": "!query.is_on_ground"
            },
            {
              "idle": "!query.is_sitting"
            }
          ],
          "blend_transition": 0.4
        },
        "death": {
          "animations": [
            "death"
          ],
          "transitions": [],
          "blend_transition": 0.1
        }
      }
    }
  }
}

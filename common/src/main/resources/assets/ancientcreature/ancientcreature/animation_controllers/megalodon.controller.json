{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.megalodon.main": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "bite": "query.action == 'attack'"
            },
            {
              "swim": "query.is_moving"
            }
          ],
          "blend_transition": 0.25
        },
        "swim": {
          "animations": [
            "swim"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "bite": "query.action == 'attack'"
            },
            {
              "idle": "!query.is_moving"
            }
          ],
          "blend_transition": 0.2
        },
        "bite": {
          "animations": [
            "bite"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "swim": "query.action != 'attack' && query.is_moving"
            },
            {
              "idle": "query.action != 'attack'"
            }
          ],
          "blend_transition": 0.08
        },
        "death": {
          "animations": [
            "idle"
          ],
          "blend_transition": 0.2
        }
      }
    }
  }
}

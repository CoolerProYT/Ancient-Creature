{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.pteranodon.main": {
      "initial_state": "fly",
      "states": {
        "fly": {
          "animations": [
            "fly"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "hurt": "query.is_hurt"
            },
            {
              "screech": "query.action == 'roar' || query.action == 'attack'"
            },
            {
              "dive": "!query.is_on_ground && query.is_attacking && query.is_running"
            },
            {
              "idle": "query.is_on_ground && !query.is_moving"
            },
            {
              "walk": "query.is_on_ground"
            },
            {
              "glide": "query.is_running"
            }
          ],
          "blend_transition": 0.2
        },
        "glide": {
          "animations": [
            "glide"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "hurt": "query.is_hurt"
            },
            {
              "screech": "query.action == 'roar' || query.action == 'attack'"
            },
            {
              "dive": "!query.is_on_ground && query.is_attacking && query.is_running"
            },
            {
              "idle": "query.is_on_ground && !query.is_moving"
            },
            {
              "walk": "query.is_on_ground"
            },
            {
              "fly": "!query.is_running"
            }
          ],
          "blend_transition": 0.4
        },
        "dive": {
          "animations": [
            "dive"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "hurt": "query.is_hurt"
            },
            {
              "idle": "query.is_on_ground && !query.is_moving"
            },
            {
              "walk": "query.is_on_ground"
            },
            {
              "fly": "!query.is_attacking"
            }
          ],
          "blend_transition": 0.15
        },
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "hurt": "query.is_hurt"
            },
            {
              "screech": "query.action == 'roar' || query.action == 'attack'"
            },
            {
              "fly": "!query.is_on_ground"
            },
            {
              "walk": "query.is_moving"
            }
          ],
          "blend_transition": 0.3
        },
        "walk": {
          "animations": [
            "idle",
            "walk"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "hurt": "query.is_hurt"
            },
            {
              "screech": "query.action == 'roar' || query.action == 'attack'"
            },
            {
              "fly": "!query.is_on_ground"
            },
            {
              "idle": "!query.is_moving"
            }
          ],
          "blend_transition": 0.2
        },
        "screech": {
          "animations": [
            "screech"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "hurt": "query.is_hurt"
            },
            {
              "fly": "query.action == 'none' && !query.is_on_ground"
            },
            {
              "walk": "query.action == 'none' && query.is_moving"
            },
            {
              "idle": "query.action == 'none'"
            }
          ],
          "blend_transition": 0.15
        },
        "hurt": {
          "animations": [
            "fly"
          ],
          "transitions": [
            {
              "death": "query.is_dead"
            },
            {
              "idle": "!query.is_hurt && query.is_on_ground && !query.is_moving"
            },
            {
              "walk": "!query.is_hurt && query.is_on_ground"
            },
            {
              "fly": "!query.is_hurt"
            }
          ],
          "blend_transition": 0.05
        },
        "death": {
          "animations": [
            "death"
          ],
          "blend_transition": 0.2
        }
      }
    }
  }
}

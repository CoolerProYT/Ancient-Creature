{
  "format_version": 1,
  "initial_state": "idle",
  "states": {
    "idle": {
      "animations": ["idle"],
      "blend_transition": 0.15,
      "transitions": [
        { "death": "query.is_dead" },
        { "hurt": "query.is_hurt" },
        { "call": "query.action == 'roar'" },
        { "attack": "query.action == 'attack'" },
        { "run": "query.is_moving && query.is_running" },
        { "walk": "query.is_moving" }
      ]
    },
    "walk": {
      "animations": ["idle", "walk"],
      "blend_transition": 0.1,
      "transitions": [
        { "death": "query.is_dead" },
        { "hurt": "query.is_hurt" },
        { "call": "query.action == 'roar'" },
        { "attack": "query.action == 'attack'" },
        { "run": "query.is_running" },
        { "idle": "!query.is_moving" }
      ]
    },
    "run": {
      "animations": ["run"],
      "blend_transition": 0.08,
      "transitions": [
        { "death": "query.is_dead" },
        { "hurt": "query.is_hurt" },
        { "call": "query.action == 'roar'" },
        { "attack": "query.action == 'attack'" },
        { "walk": "query.is_moving && !query.is_running" },
        { "idle": "!query.is_moving" }
      ]
    },
    "attack": {
      "animations": ["bite"],
      "blend_transition": 0.04,
      "transitions": [
        { "death": "query.is_dead" },
        { "run": "query.action == 'none' && query.is_running" },
        { "walk": "query.action == 'none' && query.is_moving" },
        { "idle": "query.action == 'none'" }
      ]
    },
    "call": {
      "animations": ["call"],
      "blend_transition": 0.08,
      "transitions": [
        { "death": "query.is_dead" },
        { "hurt": "query.is_hurt" },
        { "run": "query.action != 'roar' && query.is_running" },
        { "walk": "query.action != 'roar' && query.is_moving" },
        { "idle": "query.action != 'roar'" }
      ]
    },
    "hurt": {
      "animations": ["hurt"],
      "blend_transition": 0.04,
      "transitions": [
        { "death": "query.is_dead" },
        { "run": "!query.is_hurt && query.is_running" },
        { "walk": "!query.is_hurt && query.is_moving" },
        { "idle": "!query.is_hurt" }
      ]
    },
    "death": {
      "animations": ["death"],
      "blend_transition": 0.08,
      "transitions": []
    }
  }
}
